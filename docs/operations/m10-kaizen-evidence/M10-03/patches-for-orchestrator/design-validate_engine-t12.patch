+# M10-03-T12 Tier-1 refinements (adapted from addyosmani/agent-skills, MIT,
+# https://github.com/addyosmani/agent-skills, commit 2686b62; paraphrased, not copied).
+#
+# Validator-owned exemption allowlist: {"skills/<group>/<skill>/SKILL.md": {"<code>": "<reason>"}}.
+# Exemptions live here, never in skill frontmatter; a frontmatter or metadata key that tries to
+# exempt a skill is itself a finding (frontmatter_exemption).
+EXEMPTIONS: dict[str, dict[str, str]] = {}
+FENCE_RE = re.compile(r"(?ms)^[ ]{0,3}(`{3,}|~{3,})[^\n]*\n.*?^[ ]{0,3}\1[`~]*[ \t]*$")
+NEGATED_TRIGGER_RE = re.compile(r"(?i)\b(?:do not|don't|never)\s+use\s+when\b[^.;]*[.;]?")
+
+
+def strip_fences(text: str) -> str:
+    """Remove CommonMark fenced code blocks so headings inside examples are not counted."""
+    return FENCE_RE.sub("", text)
+
+
+def positive_trigger(description: str) -> bool:
+    """True when the description opens with "Use when" and a trigger survives negation stripping."""
+    stripped = NEGATED_TRIGGER_RE.sub("", description).strip()
+    return description.startswith("Use when") and "use when" in stripped.lower()
+
+
+def host_strict_findings(text: str) -> list[str]:
+    """Flag frontmatter a stricter host YAML reader may reject even though PyYAML accepts it."""
+    match = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.S)
+    if not match:
+        return []
+    problems: list[str] = []
+    for number, line in enumerate(match.group(1).splitlines(), start=2):
+        if "\t" in line:
+            problems.append(f"line {number}: tab character")
+        key_value = re.match(r"^([A-Za-z0-9_-]+):[ ]+(.*)$", line)
+        if not key_value:
+            continue
+        value = key_value.group(2).rstrip()
+        if value[:1] in {"'", '"'} and (len(value) < 2 or value[-1] != value[0]):
+            problems.append(f"line {number}: unclosed quote")
+        elif value[:1] not in {"'", '"', "|", ">", "[", "{"} and ": " in value:
+            problems.append(f"line {number}: unquoted ': ' in a plain value")
+    return problems
+
+
+def exemption_keys(data: dict) -> list[str]:
+    """Frontmatter or metadata keys that try to exempt a skill from validation."""
+    metadata = data.get("metadata") if isinstance(data.get("metadata"), dict) else {}
+    keys = [str(key) for key in list(data) + list(metadata)]
+    return sorted({key for key in keys if re.search(r"(?i)exempt|lint[-_]?ignore|skip[-_]?check", key)})
+
