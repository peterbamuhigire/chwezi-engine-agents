@@ -0,0 +1,67 @@
+"""Crafted fixtures for the four Tier-1 lint refinements (M10-03-T12)."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "validate_engine.py"
+SPEC = importlib.util.spec_from_file_location("design_validate_engine_t12", SCRIPT)
+MODULE = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = MODULE
+SPEC.loader.exec_module(MODULE)
+
+
+def skill(tmp_path: Path, frontmatter: str, body: str = "# Example\n") -> list[str]:
+    folder = tmp_path / "skills" / "99-test" / "example"
+    folder.mkdir(parents=True)
+    (folder / "SKILL.md").write_text(f"---\n{frontmatter}\n---\n\n{body}", encoding="utf-8")
+    result = MODULE.scan(tmp_path)
+    return result["findings"][0]["failed"] if result["findings"] else []
+
+
+def test_heading_inside_code_fence_is_not_counted():
+    fenced = "# Example\n\n```markdown\n## Workflow\n## Outputs\n```\n"
+    stripped = MODULE.strip_fences(fenced)
+    assert "## Workflow" not in stripped
+    assert MODULE.strip_fences("## Workflow\n") == "## Workflow\n"
+
+
+def test_fenced_headings_do_not_satisfy_required_sections(tmp_path):
+    body = "# Example\n\n~~~\n## Use When\n## Do Not Use When\n## Workflow\n## Outputs\n## Anti-Patterns\n## Examples\n## References\n~~~\n"
+    failed = skill(tmp_path, "name: example\ndescription: Use when testing fences.", body)
+    assert "required_sections" in failed
+
+
+def test_negated_trigger_alone_is_not_a_trigger():
+    assert MODULE.positive_trigger("Use when choosing a palette; do not use when auditing contrast.")
+    assert not MODULE.positive_trigger("Do not use when choosing fonts. Use when never.")
+    assert not MODULE.positive_trigger("Never use when auditing; picks fonts.")
+
+
+def test_frontmatter_exemption_key_is_a_finding(tmp_path):
+    failed = skill(tmp_path, "name: example\ndescription: Use when testing.\nmetadata:\n  lint-exempt: true")
+    assert "frontmatter_exemption" in failed
+
+
+def test_validator_owned_exemption_removes_only_the_named_code(tmp_path, monkeypatch):
+    monkeypatch.setattr(MODULE, "EXEMPTIONS", {"skills/99-test/example/SKILL.md": {"worked_example": "fixture"}})
+    failed = skill(tmp_path, "name: example\ndescription: Use when testing.")
+    assert "worked_example" not in failed
+    assert "required_sections" in failed
+
+
+def test_host_strict_yaml_subset():
+    text = "---\nname: example\ndescription: Use when x: y matters\n---\n"
+    assert any("unquoted ': '" in problem for problem in MODULE.host_strict_findings(text))
+    assert any("unclosed quote" in problem for problem in MODULE.host_strict_findings("---\nname: \"example\ndescription: ok\n---\n"))
+    assert any("tab" in problem for problem in MODULE.host_strict_findings("---\nname: example\n\tdescription: ok\n---\n"))
+    assert MODULE.host_strict_findings("---\nname: example\ndescription: \"Use when x: y\"\n---\n") == []
+
+
+def test_live_catalogue_has_no_new_findings():
+    root = Path(__file__).resolve().parents[1]
+    result = MODULE.scan(root)
+    for code in ("frontmatter_host_strict", "frontmatter_exemption"):
+        assert code not in result["failure_counts"]
