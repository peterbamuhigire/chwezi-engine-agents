{
  "name": "chwezi",
  "owner": {
    "name": "Peter Bamuhigire",
    "email": "peter.bamuhigire@gmail.com"
  },
  "metadata": {
    "description": "Chwezi skill engines — a suite of independent, standalone-installable domain engines for consulting, requirements, design, research, and infrastructure work, plus the coordination package that routes across them. Install only what you need: each plugin below installs fully on its own."
  },
  "plugins": [
    {
      "name": "chwezi-suite",
      "source": "./",
      "description": "Coordination core: routes requests to the correct engine, maintains and validates local engine checkouts (engine-orchestrator, engine-maintainer, engine-validator agents). Optional — no other Chwezi plugin depends on it.",
      "version": "1.1.0",
      "author": { "name": "Peter Bamuhigire" },
      "homepage": "https://github.com/peterbamuhigire/chwezi-engine-agents",
      "repository": "https://github.com/peterbamuhigire/chwezi-engine-agents",
      "license": "MIT",
      "keywords": ["coordination", "routing", "multi-engine"],
      "category": "coordination",
      "tags": ["coordination", "routing"],
      "strict": false
    },
    {
      "name": "srs",
      "source": {
        "source": "url",
        "url": "https://github.com/peterbamuhigire/srs-skills.git",
        "ref": "main"
      },
      "description": "159 skills: software requirements specifications, PRDs, system design, governance and compliance artefacts",
      "version": "1.1.0",
      "author": { "name": "Peter Bamuhigire" },
      "homepage": "https://github.com/peterbamuhigire/srs-skills",
      "repository": "https://github.com/peterbamuhigire/srs-skills",
      "license": "MIT",
      "category": "requirements",
      "strict": false,
      "relevance": {"topic": "requirements specifications", "signals": {"cwd": ["**/requirements", "**/srs"], "filesRead": ["**/*srs*.md", "**/*requirements*.md", "**/*.srs.yaml"]}}
    },
