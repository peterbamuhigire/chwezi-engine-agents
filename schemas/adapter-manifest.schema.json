{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-engine-agents.local/schemas/adapter-manifest.schema.json",
  "title": "Host adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "host", "version", "core_version", "entrypoints", "install_targets", "required_capabilities", "fallback"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "host": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "core_version": {"type": "string", "minLength": 1},
    "entrypoints": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "install_targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "fallback": {"type": "string", "enum": ["generic"]},
    "status": {"type": "string", "enum": ["native", "adapter", "generic", "not_assessed"]}
  }
}
