{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-engine-agents.local/schemas/agent-manifest.schema.json",
  "title": "Canonical agent manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "canonical_id", "contract_version", "required_capabilities", "output_contract"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "canonical_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "contract_version": {"type": "string", "const": "1.0"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "output_contract": {"type": "string", "minLength": 1}
  }
}
