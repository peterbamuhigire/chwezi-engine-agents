{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-engine-agents.local/schemas/validation-result.schema.json",
  "title": "Engine validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_id", "checks", "overall", "next_action"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "engine_id": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "overall": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT ASSESSED"]},
    "next_action": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "description": "Optional, backwards-compatible machine-actionable findings (M10-07-T05 / AR-09). Mirrors the Diagnostic shape of srs-skills engine/diagram_ir.py.",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "description": "Stable finding code, for example schema-required or duplicate-id."},
        "severity": {"type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH"]},
        "message": {"type": "string", "minLength": 1},
        "subject": {"type": "object", "description": "What the finding is about: file, figure id, element pointer."},
        "evidence": {"type": "object", "description": "Structured evidence: keyword, actual value, unknown properties."},
        "supported_fixes": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Repairs the validator knows to be safe; none may remove the requirement or check that failed."},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "exit_code", "evidence", "duration_ms"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT ASSESSED"]},
        "exit_code": {"type": ["integer", "null"]},
        "evidence": {"type": "string", "minLength": 1},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"exit_code": {"const": 0}, "evidence": {"minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "NOT ASSESSED"}}}, "then": {"required": ["reason"]}}
      ]
    }
  }
}
